# Neon: use the POOLED connection string (host contains "-pooler"), ssl required.
# Leave blank in local dev to use embedded PGlite (stored in .data/).
DATABASE_URL=
# Direct (non-pooled) string, used only by `npm run db:migrate` / `db:seed`. `neon env pull` provides both.
DATABASE_URL_UNPOOLED=

# Public base URL of the app (used in emails)
APP_URL=http://localhost:3000

# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts UTR / National Insurance numbers at rest. LOSING THIS KEY LOSES THAT DATA.
DATA_ENCRYPTION_KEY=

# Email (Resend). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="MTD Back Office <info@mtdbackoffice.co.uk>"

# Where uploaded files are stored (use a persistent volume, or swap lib/storage.ts for S3/R2)
STORAGE_DIR=.data/uploads

# Stripe. Use TEST keys (pk_test_ / sk_test_) until a test purchase works end to end.
# Webhook signing secret (whsec_...): Stripe > Developers > Webhooks > endpoint <APP_URL>/api/stripe/webhook,
# event checkout.session.completed. Add metadata `product_key` to each Payment Link / Checkout.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Server-side only. Prefer a restricted key (rk_...). Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me
# Publishable key. Safe in the browser, but baked in at build time (rebuild after changing).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Support
SUPPORT_EMAIL=info@mtdbackoffice.co.uk
NEXT_PUBLIC_BOOKING_URL=mailto:info@mtdbackoffice.co.uk?subject=Care%20plan%20call
